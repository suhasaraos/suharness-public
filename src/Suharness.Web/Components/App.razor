<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<ResourcePreloader />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&amp;family=IBM+Plex+Mono:wght@500&amp;display=swap" rel="stylesheet" />
	<link rel="stylesheet" href="@Assets["app.css"]" />
	<link rel="stylesheet" href="@Assets["Suharness.Web.styles.css"]" />
	@* The import map is the only inline script on the host page. It carries the per-response
	   nonce so script-src can stay strict instead of falling back to 'unsafe-inline'. *@
	<ImportMap nonce="@Nonce" />
	<HeadOutlet />
</head>

<body>
	<Routes />
	<ReconnectModal />
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
	[CascadingParameter] private HttpContext? HttpContext { get; set; }

	private string? Nonce => SecurityHeaders.NonceFor(HttpContext);
}
